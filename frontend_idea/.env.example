# Copy to .env.local only if the API is NOT reached through the Vite proxy (for example a built site on another host).
# Leave empty to use the same origin (default: Vite proxies /ask, /health, /model, /chunks, /articles, /documents → :8080).
VITE_MODDA_API=
# Where `npm run dev` forwards API calls (default http://localhost:8080):
# MODDA_API_URL=http://192.168.1.61:8080
